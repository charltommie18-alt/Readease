<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Read Ease Test</title>
    <style>
        body { font-family: Arial, sans-serif; padding: 20px; margin: 0; }
        h1 { color: #2563eb; }
        .btn { background: #2563eb; color: white; border: none; padding: 15px 20px; border-radius: 8px; font-size: 16px; margin: 10px 0; cursor: pointer; display: block; width: 100%; }
        .book { background: #f3f4f6; padding: 15px; margin: 10px 0; border-radius: 8px; }
        input[type="file"] { display: none; }
        #reader { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: white; padding: 20px; z-index: 100; }
    </style>
</head>
<body>

    <h1>📚 Read Ease</h1>
    
    <button class="btn" onclick="document.getElementById('file').click()">📤 Upload TXT File</button>
    <input type="file" id="file" accept=".txt" onchange="upload(event)">
    
    <button class="btn" onclick="showDownload()"> Download Books</button>
    
    <h2>My Books</h2>
    <div id="list"></div>
    
    <div id="reader">
        <button class="btn" onclick="closeReader()" style="background:#666;">← Back</button>
        <h2 id="title"></h2>
        <div id="content"></div>
        <button class="btn" onclick="read()">▶️ Read Aloud</button>
        <button class="btn" onclick="stop()" style="background:#f00;">️ Stop</button>
    </div>

    <script>
        let books = JSON.parse(localStorage.getItem('books') || '[]');
        
        // Show books
        function showBooks() {
            const list = document.getElementById('list');
            if (books.length === 0) {
                list.innerHTML = '<p>No books yet</p>';
                return;
            }
            list.innerHTML = '';
            books.forEach((book, i) => {
                list.innerHTML += `<div class="book" onclick="open(${i})"><b>${book.title}</b><br><small>${book.author}</small></div>`;
            });
        }
        
        // Upload
        function upload(e) {
            const file = e.target.files[0];
            if (!file) return;
            
            const reader = new FileReader();
            reader.onload = function(evt) {
                books.push({
                    title: file.name.replace('.txt', ''),
                    author: 'Uploaded',
                    content: evt.target.result
                });
                localStorage.setItem('books', JSON.stringify(books));
                showBooks();
                alert('Uploaded!');
            };
            reader.readAsText(file);
        }
        
        // Download
        function showDownload() {
            const query = prompt('Search for (e.g., Sherlock):');
            if (!query) return;
            
            alert('Searching...');
            fetch('https://gutendex.com/books?search=' + query)
                .then(r => r.json())
                .then(data => {
                    if (!data.results || data.results.length === 0) {
                        alert('No results');
                        return;
                    }
                    
                    const book = data.results[0];
                    const url = book.formats['text/plain; charset=utf-8'] || book.formats['text/plain'];
                    const title = book.title;
                    const author = book.authors[0]?.name || 'Unknown';
                    
                    if (confirm('Download: ' + title + ' by ' + author + '?')) {
                        fetch(url)
                            .then(r => r.text())
                            .then(text => {
                                books.push({title, author, content: text});
                                localStorage.setItem('books', JSON.stringify(books));
                                showBooks();
                                alert('Downloaded!');
                            })
                            .catch(err => alert('Error: ' + err));
                    }
                })
                .catch(err => alert('Error: ' + err));
        }
        
        // Open book
        function open(i) {
            const book = books[i];
            document.getElementById('title').innerText = book.title;
            document.getElementById('content').innerText = book.content;
            document.getElementById('reader').style.display = 'block';
        }
        
        // Close
        function closeReader() {
            document.getElementById('reader').style.display = 'none';
            window.speechSynthesis.cancel();
        }
        
        // Read
        function read() {
            const text = document.getElementById('content').innerText;
            const utterance = new SpeechSynthesisUtterance(text);
            window.speechSynthesis.speak(utterance);
        }
        
        // Stop
        function stop() {
            window.speechSynthesis.cancel();
        }
        
        // Init
        showBooks();
    </script>
</body>
</html>
