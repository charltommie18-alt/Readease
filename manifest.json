// Download book using fast CORS proxy
async function downloadBook(url,title,author){
  if(!url){
    alert('No text format available');
    return;
  }
  
  alert('Downloading: '+title+'\nPlease wait...');
  
  try{
    // Use faster CORS proxy
    const proxyUrl='https://corsproxy.io/?'+encodeURIComponent(url);
    const response=await fetch(proxyUrl);
    
    if(!response.ok){
      throw new Error('Download failed: '+response.status);
    }
    
    const text=await response.text();
    
    if(text.length<50){
      throw new Error('Empty file');
    }
    
    const content=text.split('\n\n').map(p=>'<p>'+p.replace(/\n/g,'<br>')+'</p>').join('');
    
    const book={
      title:title,
      author:author,
      type:'TXT',
      content:content,
      cover:'',
      progress:0,
      folder:currentFolder||null,
      timestamp:Date.now()
    };
    
    await db.books.add(book);
    await loadBooks();
    alert('✅ Downloaded! Check Library.');
  }catch(err){
    alert('Download failed: '+err.message+'\n\nTry searching for a different book.');
    console.error('Download error:',err);
  }
}
