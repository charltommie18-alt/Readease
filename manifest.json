// Modified search function to use pre-loaded database when API fails
async function searchBooks() {
  const input = document.getElementById('search-box');
  if (!input) return;
  
  const q = input.value.trim().toLowerCase();
  if (!q) {
    alert('Enter search term');
    return;
  }
  
  const resultsDiv = document.getElementById('search-results');
  if (!resultsDiv) return;
  
  resultsDiv.innerHTML = '<div style="text-align:center;padding:20px">🔍 Searching...</div>';
  
  try {
    // First try the API
    const res = await fetch('https://gutendex.com/books?search=' + encodeURIComponent(q));
    const data = await res.json();
    const apiResults = data.results || [];
    
    // Filter API results by category
    let filteredResults = [];
    const keywords = categories[currentCategory] || [];
    
    for (const book of apiResults.slice(0, 10)) {
      if (currentCategory !== 'all' && keywords.length > 0) {
        const title = (book.title || '').toLowerCase();
        const author = (book.authors && book.authors[0] ? book.authors[0].name || '' : '').toLowerCase();
        const matchesCategory = keywords.some(k => title.includes(k) || author.includes(k));
        if (!matchesCategory) continue;
      }
      
      const url = book.formats['text/plain; charset=utf-8'] || book.formats['text/plain'];
      if (!url) continue;
      
      filteredResults.push({
        title: book.title,
        author: book.authors && book.authors[0] ? book.authors[0].name || 'Unknown' : 'Unknown',
        url: url,
        source: 'api'
      });
    }
    
    // If API failed or no results, use pre-loaded database
    if (filteredResults.length === 0) {
      console.log('API failed or no results, using pre-loaded database');
      
      // Search pre-loaded database
      const dbResults = preloadedBooksDB.filter(book => {
        const matchesSearch = book.title.toLowerCase().includes(q) || 
                             book.author.toLowerCase().includes(q);
        const matchesCategory = currentCategory === 'all' || book.category === currentCategory;
        return matchesSearch && matchesCategory;
      });
      
      filteredResults = dbResults.map(book => ({
        title: book.title,
        author: book.author,
        url: book.url,
        source: 'preloaded'
      }));
    }
    
    // Display results
    if (filteredResults.length === 0) {
      resultsDiv.innerHTML = '<div style="text-align:center;padding:20px;color:#666">No books found. Try different search terms.</div>';
      return;
    }
    
    resultsDiv.innerHTML = '';
    filteredResults.forEach(book => {
      const div = document.createElement('div');
      div.className = 'book-card';
      
      const infoDiv = document.createElement('div');
      infoDiv.className = 'book-info';
      infoDiv.innerHTML = '<div class="book-title">' + book.title + '</div><div class="book-author">' + book.author + '</div><div class="book-type">Project Gutenberg</div>';
      
      const downloadBtn = document.createElement('button');
      downloadBtn.className = 'btn btn-success';
      downloadBtn.innerText = 'Download';
      downloadBtn.onclick = function() {
        downloadBook(book.url, book.title, book.author);
      };
      
      div.appendChild(infoDiv);
      div.appendChild(downloadBtn);
      resultsDiv.appendChild(div);
    });
    
  } catch (err) {
    console.error('Search error:', err);
    
    // Fallback to pre-loaded database
    const dbResults = preloadedBooksDB.filter(book => {
      const matchesSearch = book.title.toLowerCase().includes(q) || 
                           book.author.toLowerCase().includes(q);
      const matchesCategory = currentCategory === 'all' || book.category === currentCategory;
      return matchesSearch && matchesCategory;
    });
    
    if (dbResults.length === 0) {
      resultsDiv.innerHTML = '<div style="text-align:center;padding:20px;color:#ef4444">Error searching. Showing pre-loaded books instead.</div>';
      
      // Show all pre-loaded books for current category
      const allCategoryBooks = preloadedBooksDB.filter(book => 
        currentCategory === 'all' || book.category === currentCategory
      );
      
      allCategoryBooks.forEach(book => {
        const div = document.createElement('div');
        div.className = 'book-card';
        
        const infoDiv = document.createElement('div');
        infoDiv.className = 'book-info';
        infoDiv.innerHTML = '<div class="book-title">' + book.title + '</div><div class="book-author">' + book.author + '</div><div class="book-type">Project Gutenberg</div>';
        
        const downloadBtn = document.createElement('button');
        downloadBtn.className = 'btn btn-success';
        downloadBtn.innerText = 'Download';
        downloadBtn.onclick = function() {
          downloadBook(book.url, book.title, book.author);
        };
        
        div.appendChild(infoDiv);
        div.appendChild(downloadBtn);
        resultsDiv.appendChild(div);
      });
    } else {
      resultsDiv.innerHTML = '<div style="text-align:center;padding:20px;color:#ef4444">Error searching. Check internet connection.</div>';
    }
  }
}
